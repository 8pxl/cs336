# Allowlist model: ignore everything, then re-include only code I write.
# Assignment scaffolding, handouts, datasets and venvs stay untracked, so a
# fresh clone = clone the upstream assignment repo, then drop these files in.

/*
!/.gitignore
!/README.md

# Scratch / experiments (all mine)
!/random/

# --- Per assignment, my code lives in exactly two places ---
!/assignment*/
/assignment*/*
!/assignment*/cs336_*/

!/assignment*/tests/
/assignment*/tests/*
!/assignment*/tests/adapters.py

# --- Junk, at any depth (applies inside the allowlisted dirs above) ---
__pycache__/
*.py[cod]
.DS_Store
.venv/
*.pt
*.npy
